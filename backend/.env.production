# Application
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# Database
DATABASE_PATH=/app/data/kanaka.db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0

# Blockchain
BLOCKCHAIN_RPC_URL=${BLOCKCHAIN_RPC_URL}
NETWORK_ID=1
GAS_PRICE_MULTIPLIER=1.1
TX_CONFIRMATIONS=3
TX_MAX_RETRIES=5
TX_RETRY_DELAY=2000

# Authentication
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=1d
ADMIN_ADDRESSES=${ADMIN_ADDRESSES}

# API Keys
API_KEYS=${API_KEYS}

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECS=60

# CORS
CORS_ORIGINS=${CORS_ORIGINS}

# Monitoring
DISK_CHECK_PATH=/app/data

# Security
SENSITIVE_DATA_PATTERNS={"ssn":"\\d{3}-\\d{2}-\\d{4}"}