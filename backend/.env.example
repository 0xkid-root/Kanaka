# Application
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=debug

# Database
DATABASE_PATH=kanaka.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Blockchain
BLOCKCHAIN_RPC_URL=https://eth-mainnet.alchemyapi.io/v2/your-api-key
NETWORK_ID=1
GAS_PRICE_MULTIPLIER=1.1
TX_CONFIRMATIONS=1
TX_MAX_RETRIES=3
TX_RETRY_DELAY=1000

# Authentication
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=1d
ADMIN_ADDRESSES=0x1234567890123456789012345678901234567890,0x0987654321098765432109876543210987654321

# API Keys
API_KEYS=key1:name1:role1,role2;key2:name2:role1,role3

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECS=60

# CORS
CORS_ORIGINS=http://localhost:3001,https://app.kanaka.io

# Monitoring
DISK_CHECK_PATH=/

# Security
SENSITIVE_DATA_PATTERNS={"ssn":"\\d{3}-\\d{2}-\\d{4}"}